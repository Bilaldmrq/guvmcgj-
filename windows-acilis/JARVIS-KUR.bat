@echo off
title J.A.R.V.I.S. Kurulum
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText('%~f0');$m='#'+'#PS'+'#';iex $t.Substring($t.IndexOf($m)+$m.Length)"
echo.
pause
exit /b
##PS#
$html64 = ''
$ErrorActionPreference = 'Stop'
Write-Host ''
Write-Host '  J.A.R.V.I.S. acilis ekrani kuruluyor...' -ForegroundColor Cyan
$dst = Join-Path $env:LOCALAPPDATA 'JarvisAcilis'
New-Item -ItemType Directory -Force -Path $dst | Out-Null
$utf8 = New-Object System.Text.UTF8Encoding $true

$launcher = @'
# J.A.R.V.I.S. acilis ekrani
# Oturum acilinca Edge'i tam ekran (kiosk) acar, animasyonu oynatir, bitince kapatir.
$ErrorActionPreference = 'SilentlyContinue'
$dir  = Split-Path -Parent $MyInvocation.MyCommand.Path
$html = Join-Path $dir 'jarvis-acilis.html'
$url  = ([System.Uri]$html).AbsoluteUri
$prof = Join-Path $env:LOCALAPPDATA 'JarvisAcilis\EdgeProfil'

$edge = @(
  "${env:ProgramFiles(x86)}\Microsoft\Edge\Application\msedge.exe",
  "$env:ProgramFiles\Microsoft\Edge\Application\msedge.exe"
) | Where-Object { Test-Path $_ } | Select-Object -First 1
if (-not $edge) { Start-Process $html; exit }

# Masaustu yerlessin
Start-Sleep -Seconds 2

$argList = @(
  '--kiosk', "`"$url`"", '--edge-kiosk-type=fullscreen',
  "--user-data-dir=`"$prof`"",
  '--no-first-run', '--no-default-browser-check',
  '--autoplay-policy=no-user-gesture-required'
)
Start-Process -FilePath $edge -ArgumentList $argList

function Get-JarvisEdge {
  Get-CimInstance Win32_Process -Filter "Name='msedge.exe'" |
    Where-Object { $_.CommandLine -like '*JarvisAcilis*' }
}

# Sayfa bitince basligini JARVIS_DONE yapar; en gec 25 sn sonra yine kapatilir.
$deadline = (Get-Date).AddSeconds(25)
Start-Sleep -Seconds 3
while ((Get-Date) -lt $deadline) {
  $ids = @(Get-JarvisEdge | ForEach-Object { $_.ProcessId })
  if ($ids.Count -eq 0) { break }
  $done = Get-Process -Id $ids | Where-Object { $_.MainWindowTitle -like '*JARVIS_DONE*' }
  if ($done) { break }
  Start-Sleep -Milliseconds 300
}
Get-JarvisEdge | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }
'@
$kaldir = @'
# J.A.R.V.I.S. acilis ekranini tamamen kaldirir.
$ErrorActionPreference = 'SilentlyContinue'
$lnk = Join-Path ([Environment]::GetFolderPath('Startup')) 'JARVIS Acilis.lnk'
Remove-Item $lnk -Force
Get-CimInstance Win32_Process -Filter "Name='msedge.exe'" |
  Where-Object { $_.CommandLine -like '*JarvisAcilis*' } |
  ForEach-Object { Stop-Process -Id $_.ProcessId -Force }
Start-Sleep -Seconds 1
Remove-Item (Join-Path $env:LOCALAPPDATA 'JarvisAcilis') -Recurse -Force
Write-Host ''
Write-Host '  J.A.R.V.I.S. acilisi kaldirildi.' -ForegroundColor Cyan
'@
[IO.File]::WriteAllText((Join-Path $dst 'jarvis-acilis.ps1'), $launcher, $utf8)
[IO.File]::WriteAllText((Join-Path $dst 'kaldir.ps1'), $kaldir, $utf8)
[IO.File]::WriteAllText((Join-Path $dst 'KALDIR.bat'), "@echo off`r`npowershell -NoProfile -ExecutionPolicy Bypass -File `"%~dp0kaldir.ps1`"`r`npause`r`n", [System.Text.Encoding]::ASCII)
[IO.File]::WriteAllBytes((Join-Path $dst 'jarvis-acilis.html'), [Convert]::FromBase64String($html64))

$lnk = Join-Path ([Environment]::GetFolderPath('Startup')) 'JARVIS Acilis.lnk'
$sh  = New-Object -ComObject WScript.Shell
$s   = $sh.CreateShortcut($lnk)
$s.TargetPath = Join-Path $env:WINDIR 'System32\WindowsPowerShell\v1.0\powershell.exe'
$s.Arguments  = '-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "' + (Join-Path $dst 'jarvis-acilis.ps1') + '"'
$s.WorkingDirectory = $dst
$s.WindowStyle = 7
$s.Description = 'J.A.R.V.I.S. acilis ekrani'
$s.Save()

Write-Host '  Kuruldu. Her oturum acilisinda otomatik oynayacak.' -ForegroundColor Cyan
Write-Host "  Kaldirmak icin: $dst\KALDIR.bat"
Write-Host ''
Write-Host '  Simdi bir kez oynatiliyor... (atlamak icin bir tusa bas)'
& (Join-Path $dst 'jarvis-acilis.ps1')
